# ReFxRCON production environment.
#
#   cp docs/refx/env.production.example .env && chmod 600 .env
#
# Then fill in every line marked REQUIRED. The app refuses to start on several of these rather
# than limping along, which is deliberate: a panel that boots with a placeholder secret is worse
# than one that does not boot.

# --- REQUIRED --------------------------------------------------------------------------------

# Signs sessions. `openssl rand -base64 32`.
# The .env.example placeholder is refused by name, and anything under 32 bytes is refused by
# length, both BEFORE the database connect, so a bad value fails fast and loudly.
BETTER_AUTH_SECRET=

# Encrypts every stored RCON password with AES-256-GCM. `openssl rand -base64 32`.
# Must decode to EXACTLY 32 bytes. It is not validated at startup unless it is set, so a missing
# key gives you a panel that runs and cannot add servers; a malformed one throws on first use.
#
# BACK THIS UP OUT OF BAND, TODAY. A database backup without it restores to a panel that answers
# "Could not decrypt a stored server password. Has ENCRYPTION_KEY changed?" and every server has
# to be re-added by hand. docs/refx/backup.sh writes it beside each dump for exactly this reason.
ENCRYPTION_KEY=

# The exact URL people open. Scheme, host, and port only.
# parseOrigin() requires `new URL(raw).origin === raw`, which rejects all of these:
#   https://stats.refx.gg/      trailing slash
#   https://stats.refx.gg:443   explicit default port
#   https://STATS.refx.gg       uppercase host
#   https://stats.refx.gg/panel a path
# Cookies are marked Secure only when this starts with https://, and every form post from
# another origin is rejected, so getting this wrong looks like "login works, nothing else does".
ORIGIN=https://stats.refx.gg

# The bundled database's password. Docker Compose passes it as PGPASSWORD, so it never needs
# URL-encoding. If you point at an external Postgres, set DATABASE_URL instead -- it takes
# precedence -- and percent-encode any / # % or ? in the password there.
POSTGRES_PASSWORD=

# --- BEHIND A REVERSE PROXY ---------------------------------------------------------------------

# The header the proxy puts the client address in, and which entry of it to read.
#
# XFF_DEPTH counts from the END of the comma-separated list, 1-based. It is NOT "skip N from the
# left". With Caddy as the only proxy, Caddy appends the real client last, so depth 1 is right.
# Put Cloudflare in front and the last entry becomes Cloudflare's edge address: use XFF_DEPTH=2,
# or ADDRESS_HEADER=cf-connecting-ip, which is read verbatim.
#
# Only set ADDRESS_HEADER when the proxy is the ONLY way to reach the port. Otherwise anyone can
# send the header themselves and choose which IP the audit log records.
#
# Silent failure mode: if the header is absent, or the depth overruns the list, adapter-node
# throws, the app swallows it, and the address becomes empty. Nothing returns 500 -- the audit
# log just records a blank IP and every such request shares one rate-limit bucket. Check the
# audit log after the first deploy and confirm it shows real client addresses.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# --- FIRST RUN, THEN REMOVE ---------------------------------------------------------------------

# Gates /setup, the one-time owner-account creation. Compared with a timing-safe equality, and a
# wrong token writes a denied row to the audit log. /setup redirects to /sign-in once any user
# exists, so leaving this set is not an open door -- but remove it anyway once setup is done, so
# nobody has to reason about that a year from now.
# SETUP_TOKEN=

# --- HARDENING: set both of these explicitly ------------------------------------------------------

# DEFAULTS TO TRUE. It must be set to false here, or host "demo" with password "demo" serves the
# built-in mock server -- and a demo-host server bypasses the SSRF host policy entirely.
ALLOW_DEMO_SERVER=false

# Defaults to false already. Set it anyway, so the intent is on the record: with it on, strangers
# can create accounts and their own organisations on your panel.
ALLOW_ORG_SIGNUP=false

# --- PUBLIC PAGES (D4: on, everything) -----------------------------------------------------------

# There is no env var for this -- public status, leaderboards and career pages are per-org and
# per-server switches in the UI, and BOTH levels must be on:
#   Organisation -> Features   : allow public status, allow public stats
#   Server       -> Features   : public status, public stats
#
# Before turning them on, read the measured numbers in docs/refx/security.md. The short version:
# the routes are cheap (leaderboard 11 ms p50), the limiter works, but its 120-per-60s budget is
# PER CLIENT ADDRESS and shared with page loads, and the public page polls every 10 seconds -- so
# 21 viewers behind one CGNAT address all get 429s. Put a cache in front that honours the status
# route's max-age=5, or raise the limit in src/lib/server/public.ts.

# --- OPTIONAL ----------------------------------------------------------------------------------

# Rebrands page titles, the header and Discord webhook usernames in one line.
APP_NAME=ReFxRCON

# Analytics sampling interval per server. Default 20, floor 5, and 0 disables the poller
# entirely. Non-numeric or negative values also disable it -- '' , 'abc' and '-4' all mean 0, so
# a typo here silently stops sampling. '7.9' truncates to 7; '1' is raised to the floor of 5.
#
# Budget check before you lower it: each tick is two RCON calls, plus the list refresh every five
# minutes. Measured against this codebase that is 6.4 requests/min/server at 20s -- 25.6 for four
# servers, all from the VPS's single IP. (The brief says 7 and 28; reconcileServer returns before
# constructing a client when no list work is pending, so the real figure is lower.) Compare
# against limits.maxRequestsPerMinutePerIp from /v1/capabilities, recorded in Phase 0.
POLL_SECONDS=20

# Steam persona names, account age, VAC and game bans. Without it the players table shows bare
# SteamID64s and the risk score has nothing to work with.
# STEAM_API_KEY=

# "Sign in with Discord". Invite links create accounts through it.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Per-organisation server cap. Default 10; a site owner can raise it per org from the UI.
# MAX_SERVERS_PER_ORG=10

# Also audit read-only game calls. Noisy, and the audit log is already the reason to run a panel.
# AUDIT_LOG_READS=false

# Accept self-signed certificates on https game servers. This applies to EVERY https game
# server, not one of them. Leave it off unless you know why you need it.
# GAME_TLS_INSECURE=false
